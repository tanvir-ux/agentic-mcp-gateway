# Optional. Leave empty to run the FakeLLM stub (recommended for recruiters / CI).
OPENAI_API_KEY=

# llm | fake  — default fake so pytest and docker work without a vendor key
LLM_PROVIDER=fake

# Used only when LLM_PROVIDER=llm and OPENAI_API_KEY is set
OPENAI_MODEL=gpt-4o-mini

# Host/port for the optional HTTP demo
HOST=0.0.0.0
PORT=8080

# Path to markdown knowledge base (relative to repo root or absolute)
KB_DIR=docs/kb

# SQLite file for mock tickets/payments (created on first run)
DATA_DIR=data
